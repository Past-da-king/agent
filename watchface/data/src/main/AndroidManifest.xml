<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- A Watch Face Format face is resources only: no code (hasCode false is required). The agent, the next task, the approvals and the status come from the Agent watch app's complication data sources. -->
    <application android:label="@string/watch_face_name" android:hasCode="false">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <property android:name="com.google.wear.watchface.format.version" android:value="2" />
    </application>
</manifest>
