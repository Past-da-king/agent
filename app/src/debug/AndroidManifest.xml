<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the emulator probes (voice/CallProbe.kt, screen/ScreenProbe.kt). Never in a release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name="com.past9.phoneaos.voice.CallProbe" android:exported="true" />
        <receiver android:name="com.past9.phoneaos.screen.ScreenProbe" android:exported="true" />
        <!-- The assist sheet probe (assist/AssistProbe.kt). -->
        <receiver android:name="com.past9.phoneaos.assist.AssistProbe" android:exported="true" />
        <!-- The emulator wake word probe (wakeword/WakeProbe.kt): plays a WAV into the listener in place of the microphone. -->
        <receiver android:name="com.past9.phoneaos.wakeword.WakeProbe" android:exported="true" />
    </application>
</manifest>
